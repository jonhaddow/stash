{
	"name": "stash",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && node scripts/add-cron.ts",
		"preview": "wrangler dev --port 4173",
		"prepare": "svelte-kit sync && node scripts/gen-types.ts || echo ''",
		"check": "node scripts/gen-types.ts && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p src/service-worker",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"db:generate": "drizzle-kit generate",
		"gen": "node scripts/gen-types.ts",
		"db:migrate:local": "wrangler d1 migrations apply stash --local",
		"db:migrate:remote": "wrangler d1 migrations apply stash --remote",
		"deploy": "npm run build && npm run deploy:ci",
		"deploy:ci": "wrangler d1 migrations apply stash --remote && wrangler deploy",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@internationalized/date": "^3.12.4",
		"@libsql/client": "^0.18.0",
		"@playwright/test": "^1.64.0",
		"@sveltejs/adapter-cloudflare": "^8.0.0",
		"@sveltejs/kit": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26",
		"bits-ui": "^2.20.2",
		"clsx": "^2.1.1",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"shadcn-svelte": "^1.7.0",
		"svelte": "^5.56.7",
		"svelte-check": "^4.6.0",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.1",
		"vite": "^8.3.3",
		"vitest": "^5.0.3",
		"wrangler": "^4.149.0"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"allowScripts": {
		"esbuild@0.28.2": true,
		"esbuild@0.25.12": true,
		"esbuild@0.28.1": true,
		"esbuild@0.18.20": true,
		"workerd@1.20261019.1": true
	},
	"dependencies": {
		"@fontsource-variable/manrope": "^5.2.0",
		"arctic": "^3.7.0"
	},
	"overrides": {
		"runed": {
			"@sveltejs/kit": "$@sveltejs/kit"
		}
	}
}
